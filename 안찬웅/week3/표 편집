import java.util.*;
/*
    표의 행을 선택,삭제,복구하는 프로그램
    :처음 표와 비교해서 삭제되었으면 X 아니면 O
    
    알고리즘: 시뮬레이션, 배열
    
    1. 프로그램
     1.1 U X : 현재 선택된 행에서 X칸 위에 있는 행 선택
     1.2 D X : 현재 선택된 행에서 X칸 아래에 있는 행 선택
     1.3 C   : 현재 선택된 행 삭제 후, 바로 아래 행 선택
               만약 마지막행이면 삭제된 후 마지막행 선택
     1.4 z   : 가장 최근에 삭제된 행을 원래대로 복구. 단, 현재 선택된 행은 바뀌지 않습니다.

    n: 표의 행 개수
    k: 처음에 선택된 행의 위치
    cmd: 명령어
*/
class Solution {
    public String solution(int n, int k, String[] cmd) {
        String answer = "";
        List<Integer> table = new ArrayList<>();
        Deque<Integer> removeTable = new ArrayDeque<>(); //삭제된 행 저장하는 배열
        for(int i=0; i<n; i++) table.add(i);
        
        int cursor = k;
        for(int i=0; i<cmd.length; i++) {
            System.out.println(table);
            System.out.println("cursor: " + cursor + " cmd: " + cmd[i] + " table: " + table.size());
            String[] str = cmd[i].split(" ");
            String command = str[0];
            int move = 0;
            if(str.length >= 2) { 
                move = Integer.parseInt(str[1]); 
            }
            
            if(command.equals("U")) {
                cursor -= move;
            } else if(command.equals("D")) {
                cursor += move;
            } else if(command.equals("C")) {
                // 현재 행 삭제
                table.remove(cursor);
                if(table.size() <= cursor) {
                    cursor = table.size()-1;
                }
                // 삭제된 행번호(인덱스 저장)
                removeTable.offer(cursor);
                // 바로 아래 행 선택
            } else if(command.equals("Z")) {
                // 가장 최근에 삭제된 행을 원래대로 복구
                // 현재 선택된 행은 바뀌지 않습니다
                int cur = removeTable.pollLast();
                table.add(cur, cur);
            }
        }
        System.out.println(table);
        System.out.println("table: " + table.size());
        
        // 비교 후, 다르면 X 맞으면 O저장
        StringBuilder sb = new StringBuilder();
        for(int j=0; j<n; j++) {
            if(table.contains(j)) {
                sb.append("0");
            } else {
                sb.append("X");
            }
        }
        
        answer = sb.toString();
        
        return answer;
    }
}
